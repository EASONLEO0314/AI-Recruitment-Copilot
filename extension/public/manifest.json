{
  "manifest_version": 3,
  "name": "AI Recruitment Copilot",
  "version": "0.1.0",
  "description": "A local-first recruitment copilot demo for candidate review.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
