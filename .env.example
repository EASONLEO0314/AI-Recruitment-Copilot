ARC_API_HOST=127.0.0.1
ARC_API_PORT=8765
# Optional shared token for server deployments. Leave empty for local-only use.
# ARC_API_TOKEN=

# Chrome extension build target. Keep empty for local-only use.
# VITE_ARC_API_BASE_URL=http://127.0.0.1:8765
# VITE_ARC_API_TOKEN=

# Optional LLM enhancement. Scores, dimensions, risks, and evidence remain
# rule-based; the provider may generate job-level scoring weights and rewrite
# summary, highlights, recommendation, semantic review, and follow-up questions.
# ARC_LLM_PROVIDER=deepseek
# ARC_LLM_MODEL=deepseek-v4-flash
# ARC_LLM_TIMEOUT_SECONDS=4
# ARC_LLM_MAX_OUTPUT_TOKENS=520
# DEEPSEEK_API_KEY=

# Alternative OpenAI explanation provider:
# ARC_LLM_PROVIDER=openai
# ARC_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
